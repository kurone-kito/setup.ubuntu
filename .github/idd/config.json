{
  "$schema": "https://kurone-kito.github.io/idd-skill/schemas/policy.schema.json",
  "iddVersion": "0.11.0",
  "markerPrefix": "setup-ubuntu",
  "mergePolicy": "fully_autonomous_merge",
  "mergePolicyAck": "fully_autonomous_merge",
  "reviewPolicy": "copilot-advisory",
  "threadResolutionPolicy": "fast-agent-resolve",
  "claimTiming": {
    "staleAge": "PT24H",
    "heartbeatInterval": "PT12H"
  },
  "trustedMarkerActors": ["kurone-kito"],
  "workshop": {
    "exampleRepository": ""
  },
  "commands": {
    "install-deps": "true",
    "fix-validate": "npx -y markdownlint-cli2 --fix \"**/*.md\" && npx -y markdownlint-cli2 \"**/*.md\"",
    "pre-push-validate": "npx -y markdownlint-cli2 \"**/*.md\" && npx -y cspell lint \"**\" --no-progress",
    "post-fix-validate": "npx -y markdownlint-cli2 --fix \"**/*.md\" && npx -y markdownlint-cli2 \"**/*.md\" && npx -y cspell lint \"**\" --no-progress"
  },
  "helperRuntime": {
    "profile": "ephemeral-npx",
    "packageSpec": "https://codeload.github.com/kurone-kito/idd-skill/tar.gz/1f90787ebf4021673ce6e5eb69741df331fd2037"
  },
  "advisoryBotLogins": ["copilot-pull-request-reviewer[bot]"],
  "advisoryWait": {
    "convergenceScope": "idd-claimed"
  },
  "critiqueLoop": {
    "delegate": {
      "command": "npx -y markdownlint-cli2 \"**/*.md\" && npx -y cspell lint \"**\" --no-progress",
      "mode": "combined"
    }
  },
  "providerOutage": {
    "declarationTarget": 158
  },
  "issueAuthoring": {
    "journalIssue": "kurone-kito/setup.ubuntu#163"
  },
  "authoringLanguage": "en",
  "upstreamEscalation": {
    "enabled": true
  },
  "developmentBranch": "main",
  "ciGate": {
    "trustEmptyProtectionReads": true,
    "externalCheckWaivers": {
      "mode": "maintainer-authorized"
    },
    "externalChecks": {
      "waivable": [{ "selector": "idd-advisory-convergence" }]
    }
  },
  "worktreeGuard": {
    "enabled": true,
    "refuseBaseBranchCommits": true
  },
  "labels": {
    "roadmapLabelName": "roadmap",
    "blockedByHumanLabelName": "status:blocked-by-human",
    "needsDecisionLabelName": "status:needs-decision",
    "untrustedLabelerLogins": ["coderabbitai[bot]"]
  },
  "issueScope": "roadmap-first",
  "orphanFirstPolicy": "none",
  "autopilotSuitability": {
    "floor": 3
  }
}
